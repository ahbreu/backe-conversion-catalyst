APP_ENV=sandbox
COMPANY_NAME=BACKE.co

META_GRAPH_API_VERSION=v23.0
META_WHATSAPP_PHONE_NUMBER_ID=
META_WHATSAPP_ACCESS_TOKEN=
META_WHATSAPP_TEMPLATE_NAME=backe_site_lead_welcome
META_WHATSAPP_TEMPLATE_LANGUAGE=pt_BR
META_WHATSAPP_FOLLOWUP_TEMPLATE_NAME=backe_site_lead_followup
META_REQUEST_TIMEOUT_MS=10000
META_RETRY_ATTEMPTS=3
META_RETRY_BASE_DELAY_MS=500
TURNSTILE_SECRET_KEY=
META_WEBHOOK_VERIFY_TOKEN=
META_APP_SECRET=

DEFAULT_SELLER_NAME=
DEFAULT_SELLER_PHONE=
EVOLUTION_DRY_RUN=true
EVOLUTION_API_URL=
EVOLUTION_INSTANCE=
EVOLUTION_API_KEY=

PORT=3001
FRONTEND_URL=http://localhost:8080
LOCAL_LEAD_DB_ENABLED=true
# Optional. Leave empty to use the OS local app data directory.
LOCAL_LEAD_DB_PATH=
LOCAL_LEAD_LOG_ENABLED=false
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=20
LEAD_IDEMPOTENCY_WINDOW_MS=300000
# Set to true only when the backend runs behind a trusted reverse proxy.
TRUST_PROXY=false
