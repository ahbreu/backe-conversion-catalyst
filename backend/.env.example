APP_ENV=sandbox
COMPANY_NAME=BACKE.co

N8N_BASE_URL=https://groundedlungfish-n8n.cloudfy.live
N8N_LEAD_CAPTURE_WEBHOOK_TEST_URL=https://groundedlungfish-n8n.cloudfy.live/webhook-test/sandbox/backe/lead-capture
N8N_LEAD_CAPTURE_WEBHOOK_PROD_URL=https://groundedlungfish-n8n.cloudfy.live/webhook/sandbox/backe/lead-capture
N8N_HEALTHCHECK_TEST_URL=https://groundedlungfish-n8n.cloudfy.live/webhook-test/sandbox/backe/healthcheck
N8N_HEALTHCHECK_PROD_URL=https://groundedlungfish-n8n.cloudfy.live/webhook/sandbox/backe/healthcheck
N8N_REQUEST_TIMEOUT_MS=10000
N8N_RETRY_ATTEMPTS=2
N8N_RETRY_BASE_DELAY_MS=500

DEFAULT_SELLER_NAME=
DEFAULT_SELLER_PHONE=
EVOLUTION_DRY_RUN=true
EVOLUTION_API_URL=
EVOLUTION_INSTANCE=
EVOLUTION_API_KEY=

# Cloudfy PostgreSQL - operational reference only.
# Do not expose these values to the frontend. The n8n workflow should use the
# credential named "Postgres Cloudfy" instead of reading database secrets from
# versioned workflow JSON.
POSTGRES_HOST=
POSTGRES_PORT=5432
POSTGRES_DB=
POSTGRES_USER=
POSTGRES_PASSWORD=

PORT=3001
FRONTEND_URL=http://localhost:8080
LOCAL_LEAD_DB_ENABLED=true
# Optional. Leave empty to use the OS local app data directory.
LOCAL_LEAD_DB_PATH=
LOCAL_LEAD_LOG_ENABLED=false
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=20
LEAD_IDEMPOTENCY_WINDOW_MS=300000
# Set to true only when the backend runs behind a trusted reverse proxy.
TRUST_PROXY=false
