---
import { asset } from '../lib/url';
import { GUARANTEES, INTEREST_OPTIONS, CONTACT } from '../data/content';
import { NICHES, REVENUE_RANGES, whatsappLink } from '../lib/lead';
import Symbol from './Symbol.astro';
import Arrow from './Arrow.astro';
// desenhos das garantias (traço único; pathLength=1 permite “desenhar” o ícone quando o cartão entra)
const ICONS: Record<string, string> = {
  free: '<path pathLength="1" d="M4.5 11h15v9h-15z"/><path pathLength="1" d="M3.5 7.5h17V11h-17z"/><path pathLength="1" d="M12 7.5V20"/><path pathLength="1" d="M12 7.5C10.6 4.6 7 4.3 7 6.3c0 1.2 2.4 1.2 5 1.2Zm0 0c1.4-2.9 5-3.2 5-1.2 0 1.2-2.4 1.2-5 1.2Z"/>',
  clock: '<circle pathLength="1" cx="12" cy="12" r="8.5"/><path pathLength="1" d="M12 7.5V12l3.2 2"/>',
  target: '<circle pathLength="1" cx="12" cy="12" r="8.5"/><circle pathLength="1" cx="12" cy="12" r="4.2"/><path pathLength="1" d="M12 12 18.5 5.5M15.5 5.5h3v3"/>',
  team: '<circle pathLength="1" cx="9" cy="8.5" r="3.2"/><path pathLength="1" d="M3.5 19.5c.6-3.3 2.8-5.2 5.5-5.2s4.9 1.9 5.5 5.2"/><circle pathLength="1" cx="17" cy="9.5" r="2.4"/><path pathLength="1" d="M16.2 14.3c2.4.2 3.9 1.9 4.3 4.6"/>',
  unlock: '<rect pathLength="1" x="5" y="10.5" width="14" height="10" rx="2.4"/><path pathLength="1" d="M8.5 10.5V7.7a3.5 3.5 0 0 1 6.8-1.2"/><path pathLength="1" d="M12 14.4v2.4"/>',
};
const next = [
  { t: 'Você conta sobre a sua empresa', d: 'Leva menos de um minuto.' },
  { t: 'Um especialista analisa o seu cenário', d: 'Negócio, mercado e oportunidades reais.' },
  { t: 'Conversamos com o diagnóstico em mãos', d: 'Em até 24h úteis. Sem compromisso.' },
];
---
<section class="cta grain" id="diagnostico" aria-labelledby="cta-title" data-contact>
  <div class="cta__light" aria-hidden="true">
    <div class="sunrise cta__sun"></div>
    <Symbol class="cta__sym" />
  </div>

  <div class="wrap cta__grid">
    <div class="cta__info">
      <p class="eyebrow" data-reveal>Diagnóstico estratégico gratuito</p>
      <h2 class="h2 cta__title" id="cta-title" data-reveal>
        Descubra onde seu marketing está <em class="hl">perdendo</em> <span class="nobr"><em class="hl">dinheiro</em>.</span>
      </h2>
      <p class="lede" data-reveal>
        Em 1 minuto você conta sobre o seu negócio. Em até 24h úteis, um especialista da Backe te chama no WhatsApp
        com os pontos onde você está perdendo dinheiro e o que fazer primeiro. <strong>Sem custo e sem compromisso.</strong>
      </p>

    </div>

    <div class="cta__rise" aria-hidden="true"></div>

    <div class="card" data-reveal style="--d:.1s">
      <span class="card__ring" aria-hidden="true"></span>
      <p class="card__badge">Gratuito · Resposta em até 24h úteis</p>
      <div class="card__state" data-form-state>
        <header class="card__head">
          <div>
            <p class="card__kicker"><span data-step-label>Etapa 1 de 3</span>: <span data-step-name>sobre você</span></p>
            <h3 class="card__title">Leva menos de 1 minuto.</h3>
          </div>
          <svg class="card__progress" viewBox="0 0 200 40" aria-hidden="true">
            <path class="card__track" d="M2 30 C 50 30 70 8 108 10 C 146 12 160 34 198 26"></path>
            <path class="card__fill" data-progress d="M2 30 C 50 30 70 8 108 10 C 146 12 160 34 198 26" pathLength="100"></path>
          </svg>
        </header>
        <div class="card__bar" role="progressbar" aria-label="Progresso do formulário" aria-valuemin="1" aria-valuemax="3" aria-valuenow="1" data-progressbar></div>

        <form class="form" novalidate data-form autocomplete="on">
          <!-- honeypot: humanos não veem este campo -->
          <div class="hp" aria-hidden="true">
            <label for="lead-website">Website</label>
            <input id="lead-website" name="website" type="text" tabindex="-1" autocomplete="off" />
          </div>

          <fieldset class="step" data-step="1">
            <legend class="sr-only">Etapa 1 de 3: sobre você</legend>
            <div class="field">
              <label for="lead-nome">Nome completo</label>
              <input id="lead-nome" name="nome" type="text" autocomplete="name" maxlength="120" required placeholder="Como podemos te chamar?" aria-describedby="err-nome" />
              <p class="field__err" id="err-nome" data-err="nome"></p>
            </div>
            <div class="field">
              <label for="lead-whatsapp">WhatsApp</label>
              <input id="lead-whatsapp" name="whatsapp" type="tel" inputmode="tel" autocomplete="tel-national" maxlength="16" required placeholder="(00) 90000-0000" aria-describedby="err-whatsapp" />
              <p class="field__err" id="err-whatsapp" data-err="whatsapp"></p>
            </div>
          </fieldset>

          <fieldset class="step" data-step="2" hidden>
            <legend class="sr-only">Etapa 2 de 3: sobre o seu negócio</legend>
            <div class="form__row">
              <div class="field">
                <label for="lead-empresa">Empresa ou Instagram</label>
                <input id="lead-empresa" name="empresa" type="text" autocomplete="organization" maxlength="120" required placeholder="@suamarca" aria-describedby="err-empresa" />
                <p class="field__err" id="err-empresa" data-err="empresa"></p>
              </div>
              <div class="field">
                <label for="lead-email">E-mail</label>
                <input id="lead-email" name="email" type="email" inputmode="email" autocomplete="email" maxlength="255" required placeholder="voce@empresa.com" aria-describedby="err-email" />
                <p class="field__err" id="err-email" data-err="email"></p>
              </div>
            </div>
            <div class="field" role="radiogroup" aria-labelledby="lbl-nicho" aria-describedby="err-nicho">
              <p class="field__label" id="lbl-nicho">Nicho de atuação</p>
              <div class="chips">
                {NICHES.map((n) => (
                  <label class="chip"><input type="radio" name="nicho" value={n} /><span>{n}</span></label>
                ))}
              </div>
              <p class="field__err" id="err-nicho" data-err="nicho"></p>
            </div>
            <div class="field" role="radiogroup" aria-labelledby="lbl-fat" aria-describedby="err-faturamento">
              <p class="field__label" id="lbl-fat">Faturamento médio mensal</p>
              <div class="chips">
                {REVENUE_RANGES.map((n) => (
                  <label class="chip"><input type="radio" name="faturamento" value={n} /><span>{n}</span></label>
                ))}
              </div>
              <p class="field__err" id="err-faturamento" data-err="faturamento"></p>
            </div>
          </fieldset>

          <fieldset class="step" data-step="3" hidden>
            <legend class="sr-only">Etapa 3 de 3: por onde começar</legend>
            <div class="field" role="radiogroup" aria-labelledby="lbl-int">
              <p class="field__label" id="lbl-int">Por onde você quer começar? <span>(opcional)</span></p>
              <div class="chips">
                {INTEREST_OPTIONS.map((n, i) => (
                  <label class="chip"><input type="radio" name="interesse" value={n} checked={i === 0} /><span>{n}</span></label>
                ))}
              </div>
            </div>
            <div class="form__ts" data-turnstile aria-label="Verificação de segurança"></div>
          </fieldset>

          <div class="form__alert" role="alert" aria-live="assertive" data-alert hidden>
            <p data-alert-msg></p>
            <div class="form__alert-actions">
              <button type="button" class="form__retry" data-retry>Tentar novamente</button>
              <a class="form__wa" href={whatsappLink(CONTACT.whatsappText)} target="_blank" rel="noopener" data-cta="form-error-whatsapp">Falar no WhatsApp</a>
            </div>
          </div>

          <div class="form__nav">
            <button type="button" class="form__back" data-back hidden aria-label="Voltar para a etapa anterior">
              <Arrow />
            </button>
            <button type="button" class="btn btn--primary btn--block" data-next>
              <span class="btn__label" data-next-label>Continuar</span>
              <span class="btn__disc"><Arrow /></span>
            </button>
            <button type="submit" class="btn btn--primary btn--block" data-submit hidden>
              <span class="btn__label" data-submit-label>Enviar e garantir meu diagnóstico</span>
              <span class="btn__disc"><Arrow /></span>
            </button>
          </div>

          <p class="form__legal">
            Seus dados são usados só para retornar o contato. Veja a <a href={asset('privacidade.html')} target="_blank" rel="noopener">Política de Privacidade</a>.
          </p>
        </form>
      </div>

      <div class="success" data-success hidden tabindex="-1" aria-live="polite">
        <div class="success__sun" aria-hidden="true"><span></span></div>
        <p class="eyebrow">Solicitação recebida</p>
        <h3 class="success__title">Obrigado<span data-success-name></span>. A conversa começou.</h3>
        <p class="success__p">
          Um especialista da Backe vai analisar o seu negócio e entrar em contato pelo WhatsApp em até <strong>24h úteis</strong>.
        </p>
        <a class="btn btn--ghost" href={whatsappLink('Olá! Acabei de pedir meu diagnóstico pelo site da BACKE.co.')} target="_blank" rel="noopener" data-cta="success-whatsapp">
          <span class="btn__label">Adiantar a conversa no WhatsApp</span>
          <span class="btn__disc"><Arrow /></span>
        </a>
      </div>
    </div>

    <div class="cta__more">
      <ol class="cta__next" aria-label="O que acontece depois que você envia">
        {
          next.map((n, i) => (
            <li>
              <span class="cta__next-n">{String(i + 1).padStart(2, '0')}</span>
              <div>
                <strong>{n.t}</strong>
                <span>{n.d}</span>
              </div>
            </li>
          ))
        }
      </ol>

      <ul class="cta__g" aria-label="Garantias do diagnóstico">
        {
          GUARANTEES.map((g, i) => (
            <li class:list={['gt', i === 0 && 'gt--hl']} data-card style={`--d:${i * 0.08}s`}>
              <span class="gt__ic" aria-hidden="true">
                <svg viewBox="0 0 24 24" focusable="false" set:html={ICONS[g.icon]} />
              </span>
              <strong class="gt__t" set:html={g.t} />
              <span class="gt__d">{g.d}</span>
            </li>
          ))
        }
      </ul>
    </div>
  </div>
</section>

<style>
  .cta {
    position: relative;
    overflow: hidden;
    /* clip: corta igual, mas o navegador não consegue rolar a seção para o lado ao focar um campo */
    overflow: clip;
    padding-block: clamp(5rem, 11vw, 9rem);
    background:
      radial-gradient(90% 60% at 50% 115%, rgb(254 67 77 / 0.35), rgb(234 104 50 / 0.18) 40%, transparent 70%),
      linear-gradient(180deg, var(--ink), #0d0806 60%, #170a06);
  }
  .cta__light {
    position: absolute;
    inset: 0;
    pointer-events: none;
  }
  .cta__sun {
    width: 140vmax;
    height: 140vmax;
    left: 50%;
    bottom: -112vmax;
    translate: -50% 0;
  }
  .cta__sym {
    position: absolute;
    left: -14vw;
    bottom: -30vw;
    width: 60vw;
    opacity: 0.1;
  }
  .cta__grid {
    position: relative;
    grid-template-areas: 'info card' 'more card';
    display: grid;
    grid-template-columns: 1fr minmax(0, 560px);
    gap: clamp(40px, 6vw, 96px);
    align-items: start;
  }
  .cta__more {
    grid-area: more;
    display: grid;
    gap: 28px;
    align-content: start;
  }
  .card {
    grid-area: card;
    z-index: 1;
  }
  /* sol nascendo atrás do card: --rise vem de public/sol.js (0 → 1 conforme a seção entra) */
  .cta__rise {
    --rise-size: clamp(220px, 26vw, 380px);
    grid-area: card;
    justify-self: end;
    align-self: start;
    z-index: 0;
    width: var(--rise-size);
    height: var(--rise-size);
    border-radius: 50%;
    background: var(--sun);
    box-shadow: 0 0 90px rgb(254 67 77 / 0.45);
    transform: translate(38%, calc(-42% + (1 - var(--rise, 1)) * 55%));
    pointer-events: none;
  }
  .cta__info {
    position: relative;
    z-index: 1;
    grid-area: info;
    display: grid;
    gap: 28px;
    align-content: start;
    padding-top: 8px;
  }
  .cta__title {
    max-width: 12ch;
  }
  .cta__info .lede {
    color: #c9c5c0;
  }
  .cta__next {
    display: grid;
    gap: 0;
    margin-top: 8px;
    border-top: 1px solid var(--line);
  }
  .cta__next li {
    display: grid;
    grid-template-columns: 64px 1fr;
    gap: 12px;
    align-items: baseline;
    padding: 18px 0;
    border-bottom: 1px solid var(--line);
  }
  .cta__next .cta__next-n {
    font-family: var(--f-display);
    font-size: 2.2rem;
    font-weight: 600;
    line-height: 0.9;
    letter-spacing: -0.05em;
    background: linear-gradient(180deg, var(--sun-1), var(--sun-3));
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }
  .cta__next strong {
    display: block;
    font-weight: 600;
  }
  .cta__next span {
    color: var(--mute);
    font-size: 0.92rem;
  }
  /* garantias: cartões de borda fina, texto alinhado embaixo, ícone fino no canto, palavra-chave em serifada laranja */
  .cta__g {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 10px;
  }
  .gt {
    position: relative;
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    align-items: flex-start;
    text-align: left;
    min-height: 132px;
    padding: 16px 16px 18px;
    border-radius: 16px;
    background: linear-gradient(180deg, rgb(255 255 255 / 0.04), rgb(255 255 255 / 0.012) 60%);
    box-shadow: inset 0 1px 0 rgb(255 255 255 / 0.06), inset 0 0 0 1px rgb(255 255 255 / 0.07);
    transition: box-shadow 0.35s var(--ease-out);
  }
  .gt:hover {
    box-shadow: inset 0 1px 0 rgb(255 255 255 / 0.08), inset 0 0 0 1px rgb(234 104 50 / 0.4);
  }
  .gt__ic {
    position: absolute;
    top: 14px;
    right: 14px;
    color: rgb(234 104 50 / 0.85);
  }
  .gt__ic svg {
    display: block;
    width: 20px;
    height: 20px;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.4;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
  /* o ícone se desenha quando o cartão entra */
  :global(.js) .gt__ic :global(:is(path, circle, rect)) {
    stroke-dasharray: 1;
    stroke-dashoffset: 1;
    transition: stroke-dashoffset 1.3s var(--ease-out) calc(var(--d, 0s) + 0.35s);
  }
  :global(.js) .gt:global(.is-in) .gt__ic :global(:is(path, circle, rect)) {
    stroke-dashoffset: 0;
  }
  .gt__t {
    font: 600 1.08rem/1.12 var(--f-display);
    letter-spacing: -0.02em;
    color: var(--text);
    margin: 0 0 6px;
    padding-right: 30px; /* não encostar no ícone */
    text-wrap: balance;
  }
  .gt__t :global(em) {
    font-family: var(--f-serif);
    font-style: italic;
    font-weight: 400;
    font-size: 1.18em;
    letter-spacing: -0.01em;
    color: var(--sun-2);
  }
  .gt__d {
    font-size: 0.82rem;
    line-height: 1.45;
    color: #8f8a85;
  }
  /* destaque: Diagnóstico 100% gratuito */
  .gt--hl {
    grid-column: 1 / -1;
    min-height: 0;
    padding: 20px;
    background:
      radial-gradient(120% 140% at 0% 0%, rgb(234 104 50 / 0.16), transparent 55%),
      linear-gradient(180deg, rgb(255 255 255 / 0.04), rgb(255 255 255 / 0.012));
    box-shadow: inset 0 1px 0 rgb(255 255 255 / 0.07), inset 0 0 0 1px rgb(234 104 50 / 0.32);
  }
  .gt--hl::before {
    content: none;
  }
  .gt--hl .gt__ic {
    top: 18px;
    right: 18px;
    color: rgb(234 104 50 / 0.85);
    background: none;
    box-shadow: none;
  }
  .gt--hl .gt__t {
    font-size: 1.5rem;
    line-height: 1.05;
  }
  .gt--hl .gt__d {
    font-size: 0.9rem;
    color: #b0a9a3;
  }
  @media (min-width: 900px) {
    .gt {
      min-height: 118px;
    }
  }

  /* ───── card do formulário ───── */
  .card {
    position: relative;
    border-radius: var(--radius);
    padding: clamp(24px, 3.2vw, 40px);
    background: linear-gradient(180deg, rgb(28 26 25 / 0.86), rgb(16 15 14 / 0.9));
    backdrop-filter: blur(18px);
    -webkit-backdrop-filter: blur(18px);
    box-shadow:
      inset 0 0 0 1px rgb(255 255 255 / 0.06),
      0 40px 120px -40px rgb(254 67 77 / 0.6),
      0 0 70px -20px rgb(241 143 52 / 0.35);
  }
  /* borda em degradê: o fundo vira só contorno pela máscara */
  .card__ring {
    position: absolute;
    inset: 0;
    padding: 1.5px;
    border-radius: inherit;
    background: linear-gradient(160deg, var(--sun-1), var(--sun-2), var(--sun-3));
    -webkit-mask:
      linear-gradient(#000 0 0) content-box,
      linear-gradient(#000 0 0);
    -webkit-mask-composite: xor;
    mask:
      linear-gradient(#000 0 0) content-box exclude,
      linear-gradient(#000 0 0);
    pointer-events: none;
  }
  .card__badge {
    position: absolute;
    top: 0;
    left: 50%;
    transform: translate(-50%, -50%);
    margin: 0;
    padding: 7px 16px;
    border-radius: 999px;
    background: var(--sun);
    color: #1a0b05;
    font-size: 0.8rem;
    font-weight: 700;
    letter-spacing: 0.01em;
    white-space: nowrap;
    box-shadow: 0 10px 30px -8px rgb(254 67 77 / 0.6);
  }
  .card__head {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: 16px;
  }
  .card__kicker {
    font-size: 0.75rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--mute);
  }
  .card__kicker span:first-child {
    color: var(--orange);
    font-weight: 600;
  }
  .card__title {
    margin-top: 8px;
    font-family: var(--f-display);
    font-size: clamp(1.6rem, 2.4vw, 2rem);
    font-weight: 600;
    letter-spacing: -0.035em;
    line-height: 1.05;
  }
  .card__progress {
    width: 110px;
    flex: none;
    overflow: visible;
  }
  .card__track,
  .card__fill {
    fill: none;
    stroke-width: 3;
    stroke-linecap: round;
  }
  .card__track {
    stroke: rgb(255 255 255 / 0.1);
  }
  .card__fill {
    stroke: url(#sun-v);
    stroke-dasharray: 100;
    stroke-dashoffset: calc(100 - var(--progress, 33));
    transition: stroke-dashoffset 0.8s var(--ease-out);
  }
  .card__bar {
    height: 0;
  }

  .form {
    margin-top: 28px;
    display: grid;
    gap: 22px;
  }
  .hp {
    position: absolute;
    left: -9999px;
    width: 1px;
    height: 1px;
    overflow: hidden;
  }
  .step {
    border: 0;
    margin: 0;
    padding: 0;
    min-width: 0;
    display: grid;
    gap: 22px;
  }
  .step.is-entering {
    animation: step-in 0.6s var(--ease-out) both;
  }
  @keyframes step-in {
    from {
      opacity: 0;
      transform: translateX(var(--dir, 24px));
    }
  }
  .form__row {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 22px;
  }
  .field {
    display: grid;
    gap: 8px;
    min-width: 0;
  }
  .field > label,
  .field__label {
    font-size: 0.78rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: #bdb8b2;
  }
  .field__label span {
    text-transform: none;
    letter-spacing: 0;
    font-weight: 400;
    color: var(--mute-2);
  }
  .field input[type='text'],
  .field input[type='tel'],
  .field input[type='email'] {
    width: 100%;
    height: 52px;
    padding: 0 2px;
    border: 0;
    border-bottom: 1px solid var(--line-strong);
    border-radius: 0;
    background: transparent;
    font-size: 1.1rem;
    color: var(--text);
    transition: border-color 0.3s;
    -webkit-appearance: none;
    appearance: none;
  }
  .field input::placeholder {
    color: #5f5c58;
  }
  .field input:focus {
    outline: none;
    border-bottom-color: var(--orange);
    box-shadow: 0 1px 0 var(--orange);
  }
  .field input[aria-invalid='true'] {
    border-bottom-color: #ff6b6b;
  }
  .field input:-webkit-autofill {
    -webkit-text-fill-color: var(--text);
    -webkit-box-shadow: 0 0 0 100px #1a1817 inset;
  }
  .field__err {
    min-height: 0;
    font-size: 0.82rem;
    color: #ff8a8a;
  }
  .field__err:empty {
    display: none;
  }
  .chips {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }
  .chip {
    position: relative;
    cursor: pointer;
  }
  .chip input {
    position: absolute;
    opacity: 0;
    inset: 0;
    margin: 0;
    cursor: pointer;
  }
  .chip span {
    display: inline-flex;
    align-items: center;
    min-height: 40px;
    padding: 8px 15px;
    border-radius: 999px;
    font-size: 0.9rem;
    line-height: 1.2;
    color: #d6d2cd;
    background: rgb(255 255 255 / 0.03);
    box-shadow: inset 0 0 0 1px var(--line-strong);
