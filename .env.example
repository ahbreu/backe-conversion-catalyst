APP_ENV=sandbox
COMPANY_NAME=BACKE.co

N8N_BASE_URL=https://groundedlungfish-n8n.cloudfy.live
N8N_LEAD_CAPTURE_WEBHOOK_TEST_URL=https://groundedlungfish-n8n.cloudfy.live/webhook-test/sandbox/backe/lead-capture
N8N_LEAD_CAPTURE_WEBHOOK_PROD_URL=https://groundedlungfish-n8n.cloudfy.live/webhook/sandbox/backe/lead-capture
N8N_HEALTHCHECK_TEST_URL=https://groundedlungfish-n8n.cloudfy.live/webhook-test/sandbox/backe/healthcheck
N8N_HEALTHCHECK_PROD_URL=https://groundedlungfish-n8n.cloudfy.live/webhook/sandbox/backe/healthcheck
N8N_REQUEST_TIMEOUT_MS=10000
N8N_RETRY_ATTEMPTS=2
N8N_RETRY_BASE_DELAY_MS=500

DEFAULT_SELLER_NAME=
DEFAULT_SELLER_PHONE=
EVOLUTION_DRY_RUN=true
EVOLUTION_API_URL=
EVOLUTION_INSTANCE=
EVOLUTION_API_KEY=

# Cloudfy PostgreSQL - operational reference only.
# Do not prefix these with VITE_ and do not expose them to the frontend.
# In production, prefer configuring the Postgres credential directly in n8n as
# "Postgres Cloudfy" using the values from the Cloudfy panel.
POSTGRES_HOST=
POSTGRES_PORT=5432
POSTGRES_DB=
POSTGRES_USER=
POSTGRES_PASSWORD=

PORT=3001
FRONTEND_URL=http://localhost:8080
LOCAL_LEAD_DB_ENABLED=true
# Optional. Leave empty to use the OS local app data directory.
LOCAL_LEAD_DB_PATH=
LOCAL_LEAD_LOG_ENABLED=false
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=20
LEAD_IDEMPOTENCY_WINDOW_MS=300000
# Set to true only when the backend runs behind a trusted reverse proxy.
TRUST_PROXY=false

# Followup Notifier - TEX WhatsApp follow-up scheduler
REDIS_URL=redis://localhost:6379
FOLLOWUP_SCHEDULER_TOKEN=
FOLLOWUP_DRY_RUN=true
FOLLOWUP_WINDOW_MINUTES=10

VITE_API_URL=http://localhost:3001
VITE_APP_ENV=sandbox
VITE_COMPANY_NAME=BACKE.co
VITE_MAINTENANCE_MODE=false
VITE_PUBLIC_WHATSAPP_PHONE=
VITE_PUBLIC_WHATSAPP_MESSAGE=Olá, vim pelo site da BACKE.co e quero entender como automatizar atendimento e captação de leads.
