        "assignments": {
          "assignments": [
            {
              "id": "1",
              "name": "message",
              "value": "={{ (function(){ var S=$(\"Postgres - Estatisticas\").first().json;var L=$(\"Postgres - Lista de Leads\").all().map(function(i){return i.json;});var T=parseInt(S.total_leads)||0;var N=parseInt(S.leads_novos)||0;var C=parseInt(S.leads_contactados)||0;var E=parseInt(S.leads_com_erro)||0;var msg=\"*Relatorio Semanal de Leads - BACKE.co*\\nPeriodo: ultimos 7 dias\\n\\n*Resumo:*\\n\";msg+=\"Total: \"+T+\" | Novos: \"+N+\" | Contactados: \"+C+\" | Erro: \"+E+\"\\n\\n\";var hot=[]; var pending=[]; var all=[];var labels={recebido:\"Novo\",whatsapp_enviado:\"Contactado\",erro_envio:\"Erro\",frio:\"Frio\",qualificado:\"Qualificado\",convertido:\"Convertido\"};for(var i=0;i<L.length;i++){var l=L[i];var st=labels[l.status]||l.status;var em=l.status===\"whatsapp_enviado\"?\"[OK]\":l.status===\"erro_envio\"?\"[ERRO]\":\"[NOVO]\";if(l.status===\"recebido\"){hot.push((hot.length+1)+\". \"+l.nome+\" (\"+(l.empresa||\"N/A\")+\") - \"+l.telefone+\" - \"+st);}if(l.status===\"recebido\"||l.status===\"whatsapp_enviado\"){pending.push((pending.length+1)+\". \"+l.nome+\" (\"+(l.empresa||\"N/A\")+\") - \"+l.telefone+\" - \"+st);}all.push(em+\" \"+(i+1)+\". \"+l.nome+\" (\"+(l.empresa||\"N/A\")+\") - \"+l.telefone+\" - \"+st);}if(hot.length>0){msg+=\"LEADS QUENTES:\\n\"+hot.join(\"\\n\")+\"\\n\\n\";}if(pending.length>0){msg+=\"PENDENTES DE FOLLOW-UP:\\n\"+pending.join(\"\\n\")+\"\\n\\n\";}if(all.length>0){msg+=\"TODOS OS LEADS:\\n\"+all.join(\"\\n\")+\"\\n\\n\";}else{msg+=\"Nenhum lead esta semana.\\n\\n\";}if(pending.length>0){msg+=\"Acao: Fazer follow-up de \"+pending.length+\" lead(s).\";}else if(N>0){msg+=\"Acao: Contatar \"+N+\" lead(s) novo(s).\";}else{msg+=\"Acao: Nenhuma pendencia.\";}return msg; })() }}",
              "type": "string"
            }
          ]
        },
        "options": {}
