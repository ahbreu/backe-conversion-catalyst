{
  "name": "TEX - Followup Notifier Scheduler",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "minutes",
              "minutesInterval": 1
            }
          ]
        }
      },
      "id": "tex-fu-scheduler-trigger",
      "name": "Schedule - Every 1 Minute",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [-400, 0]
    },
    {
      "parameters": {
        "jsCode": "const now = Date.now();\nconst FOLLOWUP_WINDOW_MS = 10 * 60 * 1000;\n\nreturn [{\n  json: {\n    scanTimestamp: new Date().toISOString(),\n    scanEpochMs: now,\n    followupWindowMs: FOLLOWUP_WINDOW_MS,\n    instanceName: $env.EVOLUTION_INSTANCE || 'barbearia',\n    evolutionBaseUrl: $env.EVOLUTION_API_URL || '',\n    dryRun: String($env.FOLLOWUP_DRY_RUN || '').toLowerCase() === 'true'\n  }\n}];"
      },
      "id": "tex-fu-init",
      "name": "Code - Init Scan Context",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [-160, 0]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $env.FOLLOWUP_SCHEDULER_WEBHOOK_URL || '' }}",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Content-Type",
              "value": "application/json"
            },
            {
              "name": "X-Scheduler-Token",
              "value": "={{ $env.FOLLOWUP_SCHEDULER_TOKEN || '' }}"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ {\n  action: 'scan_eligible',\n  scanTimestamp: $json.scanTimestamp,\n  scanEpochMs: $json.scanEpochMs\n} }}",
        "options": {
          "timeout": 15000
        }
      },
      "id": "tex-fu-scan-redis",
      "name": "HTTP - Scan Eligible Sessions",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [80, 0],
      "continueOnFail": true
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "type": "object"
          },
          "conditions": [
            {
              "id": "cond-has-sessions",
              "leftValue": "={{ $json.ok }}",
              "rightValue": true,
              "operator": { "type": "boolean", "operation": "true" }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "tex-fu-check-sessions",
      "name": "IF - Has Eligible Sessions?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [340, 0]
    },
    {
      "parameters": {
        "jsCode": "const sessions = $input.first().json.sessions || [];\nreturn sessions.map(s => ({ json: { ...s, scanTimestamp: $input.first().json.scanTimestamp } }));"
      },
      "id": "tex-fu-split-sessions",
      "name": "Code - Split Sessions",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [600, -160]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $env.FOLLOWUP_SCHEDULER_WEBHOOK_URL || '' }}",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Content-Type",
              "value": "application/json"
            },
            {
              "name": "X-Scheduler-Token",
              "value": "={{ $env.FOLLOWUP_SCHEDULER_TOKEN || '' }}"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ {\n  action: 'acquire_lock',\n  sessionId: $json.sessionId\n} }}",
        "options": {
          "timeout": 10000
        }
      },
      "id": "tex-fu-acquire-lock",
      "name": "HTTP - Acquire Session Lock",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [860, -160],
      "continueOnFail": true
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "type": "object"
          },
          "conditions": [
            {
              "id": "cond-lock-acquired",
              "leftValue": "={{ $json.acquired }}",
              "rightValue": true,
              "operator": { "type": "boolean", "operation": "true" }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "tex-fu-check-lock",
      "name": "IF - Lock Acquired?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [1120, -160]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $env.FOLLOWUP_SCHEDULER_WEBHOOK_URL || '' }}",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Content-Type",
              "value": "application/json"
            },
            {
              "name": "X-Scheduler-Token",
              "value": "={{ $env.FOLLOWUP_SCHEDULER_TOKEN || '' }}"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ {\n  action: 'revalidate',\n  sessionId: $json.sessionId\n} }}",
        "options": {
          "timeout": 10000
        }
      },
      "id": "tex-fu-revalidate",
      "name": "HTTP - Revalidate Eligibility",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1380, -280],
      "continueOnFail": true
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "type": "object"
          },
          "conditions": [
            {
              "id": "cond-still-eligible",
              "leftValue": "={{ $json.eligible }}",
              "rightValue": true,
              "operator": { "type": "boolean", "operation": "true" }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "tex-fu-check-eligible",
      "name": "IF - Still Eligible?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [1640, -280]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "type": "object"
          },
          "conditions": [
            {
              "id": "cond-dry-run",
              "leftValue": "={{ String($env.FOLLOWUP_DRY_RUN || '').toLowerCase() }}",
              "rightValue": "true",
              "operator": { "type": "string", "operation": "equals" }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "tex-fu-check-dry-run",
      "name": "IF - Dry Run Mode?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [1900, -400]
    },
    {
      "parameters": {
        "jsCode": "const session = $input.first().json;\nreturn [{\n  json: {\n    sessionId: session.sessionId,\n    phone: session.phone,\n    nudgeText: `Oi, ${session.phone}! Vi que sua mensagem chegou e ainda nao conseguimos te atender por aqui. Quer que eu te ajude com algo?`,\n    dryRun: true,\n    sentAt: new Date().toISOString()\n  }\n}];"
      },
      "id": "tex-fu-dry-run",
      "name": "Code - Simulate Nudge",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [2160, -520]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $json.evolutionBaseUrl + '/message/sendText/' + $json.instanceName }}",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "apikey",
              "value": "={{ $env.EVOLUTION_API_KEY || '' }}"
            },
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ {\n  number: $json.phone,\n  text: `Ola! Vi que sua mensagem chegou e ainda nao conseguimos te atender por aqui. Quer que eu te ajude com algo?`\n} }}",
        "options": {
          "timeout": 15000
        }
      },
      "id": "tex-fu-send-nudge",
      "name": "HTTP - Send WhatsApp Nudge",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [2160, -280],
      "continueOnFail": true
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $env.FOLLOWUP_SCHEDULER_WEBHOOK_URL || '' }}",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Content-Type",
              "value": "application/json"
            },
            {
              "name": "X-Scheduler-Token",
              "value": "={{ $env.FOLLOWUP_SCHEDULER_TOKEN || '' }}"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ {\n  action: 'mark_sent',\n  sessionId: $json.sessionId\n} }}",
        "options": {
          "timeout": 10000
        }
      },
      "id": "tex-fu-mark-sent",
      "name": "HTTP - Mark Followup Sent",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [2420, -400],
      "continueOnFail": true
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $env.FOLLOWUP_SCHEDULER_WEBHOOK_URL || '' }}",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Content-Type",
              "value": "application/json"
            },
            {
              "name": "X-Scheduler-Token",
              "value": "={{ $env.FOLLOWUP_SCHEDULER_TOKEN || '' }}"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ {\n  action: 'release_lock',\n  sessionId: $json.sessionId\n} }}",
        "options": {
          "timeout": 10000
        }
      },
      "id": "tex-fu-release-lock",
      "name": "HTTP - Release Session Lock",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [2680, -400],
      "continueOnFail": true
    },
    {
      "parameters": {
        "jsCode": "const results = $input.all();\nconst sent = results.filter(r => r.json.sent).length;\nconst skipped = results.filter(r => !r.json.sent).length;\n\nreturn [{\n  json: {\n    scanComplete: true,\n    totalProcessed: results.length,\n    nudgesSent: sent,\n    sessionsSkipped: skipped,\n    completedAt: new Date().toISOString()\n  }\n}];"
      },
      "id": "tex-fu-aggregate",
      "name": "Code - Aggregate Results",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [2940, -400]
    },
    {
      "parameters": {
        "jsCode": "const sessions = $input.first().json.sessions || [];\nreturn sessions.map(s => ({\n  json: {\n    sessionId: s.sessionId,\n    reason: 'lock_not_acquired',\n    skipped: true\n  }\n}));"
      },
      "id": "tex-fu-lock-failed-branch",
      "name": "Code - Log Lock Failure",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [1380, -40]
    },
    {
      "parameters": {
        "jsCode": "const session = $input.first().json;\nreturn [{\n  json: {\n    sessionId: session.sessionId,\n    reason: session.reason || 'no_longer_eligible',\n    skipped: true\n  }\n}];"
      },
      "id": "tex-fu-ineligible-branch",
      "name": "Code - Log Ineligible",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [1900, -160]
    },
    {
      "parameters": {
        "jsCode": "return [{\n  json: {\n    scanComplete: true,\n    totalProcessed: 0,\n    nudgesSent: 0,\n    sessionsSkipped: 0,\n    noEligibleSessions: true,\n    completedAt: new Date().toISOString()\n  }\n}];"
      },
      "id": "tex-fu-no-sessions",
      "name": "Code - No Eligible Sessions",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [600, 160]
    }
  ],
